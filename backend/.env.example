# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://aria:ariapassword@localhost:5432/aria_db
POSTGRES_USER=aria
POSTGRES_PASSWORD=ariapassword
POSTGRES_DB=aria_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192

# OpenAI (embeddings only)
OPENAI_API_KEY=sk-...

# Clerk Auth
CLERK_SECRET_KEY=sk_...
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_WEBHOOK_SECRET=whsec_...

# Encryption (AES-256 for credentials at rest)
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-encoded-key

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=ls__...
LANGCHAIN_PROJECT=aria

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=aria-outputs

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Feature Flags
FEATURE_PROACTIVE_AGENT=false
FEATURE_GOOGLE_SLIDES=false
FEATURE_WEASYPRINT=false
